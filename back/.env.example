APP_NAME=MonClubHouse
APP_URL=https://monclubhouse.fr
NODE_ENV=production
PORT=3000

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monclubhouse_db
DB_USER=monclubhouse_user
DB_PASS=votre_mot_de_passe_db

# JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire
JWT_REFRESH_SECRET=votre_secret_refresh_jwt_different
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_CALLBACK_URL=https://monclubhouse.fr/auth/google/callback

# API FFF (Football France)
FFF_API_KEY=votre_cle_api_fff
FFF_API_URL=https://api.fff.fr/v1

# Socket.io
SOCKET_CORS_ORIGIN=https://monclubhouse.fr

# Upload fichiers
UPLOAD_PATH=./public/uploads
MAX_FILE_SIZE=5242880

# Base de données — schéma + seed (à importer manuellement dans phpMyAdmin)
DB_SCHEMA_FILE=../database.sql

# ─── Email / SMTP Hostinger ────────────────────────────────────────────────
# Port 587 = STARTTLS (recommandé), Port 465 = SSL (SMTP_SECURE=true)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=convocations@monclubhouse.fr
SMTP_PASS=votre_mot_de_passe_email_hostinger

# ─── Abonnement & Stripe ────────────────────────────────────────────────────
# Coupure générale : tant que false, aucun utilisateur n'est jamais bloqué.
SUBSCRIPTION_ENABLED=false
# 'test' (défaut, sûr) utilise les clés sk_test_/pk_test_ ; 'production' bascule sur les clés live.
STRIPE_ENV=test

# Tarifs individuels (par utilisateur, en euros)
SUBSCRIPTION_MONTH_PRICE=5.00
SUBSCRIPTION_ANNUAL_PRICE=50.00
# Tarifs club (1 achat par le dirigeant/admin couvre tous les membres, en euros)
SUBSCRIPTION_CLUB_MONTH_PRICE=600.00
SUBSCRIPTION_CLUB_ANNUAL_PRICE=6000.00

# Clés Stripe test (utilisées tant que STRIPE_ENV=test)
STRIPE_API_KEY_TEST=sk_test_votre_cle_secrete
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_votre_cle_publique

# Clés Stripe live (utilisées uniquement si STRIPE_ENV=production)
STRIPE_API_KEY=rk_live_ou_sk_live_votre_cle_secrete
STRIPE_PUBLISHABLE_KEY=pk_live_votre_cle_publique

# Secret de vérification de signature du webhook Stripe (dashboard Stripe > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook
